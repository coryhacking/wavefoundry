    "family": {"sans": "Inter, system-ui, sans-serif", "mono": "SF Mono, ui-monospace, monospace"},
    "size": {"xs": "11px", "sm": "12px", "md": "14px", "lg": "16px", "xl": "20px", "2xl": "28px"},
    "weight": {"regular": 400, "medium": 500, "semibold": 600, "bold": 700},
    "leading": {"tight": 1.2, "normal": 1.5, "loose": 1.8}
  },
  "elevation": {
    "none": "none",
    "sm": "0 1px 2px rgba(0,0,0,0.24)",
