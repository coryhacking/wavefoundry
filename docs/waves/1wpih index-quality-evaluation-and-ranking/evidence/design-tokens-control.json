{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "wavefoundry-dashboard-tokens",
  "version": "2.4.0",
  "description": "NEGATIVE CONTROL for wave 1wpie requirement 12. A realistic design-token document: repeated-key shape, JSON extension, sizeable. It must remain in its ordinary domain and must NOT be classified as Evidence/Data.",
  "color": {
    "surface": {"base": "#0b0d10", "raised": "#141820", "overlay": "#1c2230", "inverse": "#f7f9fc"},
    "text": {"primary": "#e8edf5", "secondary": "#9aa7bd", "muted": "#67748c", "inverse": "#0b0d10"},
    "accent": {"default": "#4c8dff", "hover": "#6ba0ff", "pressed": "#3a76e0", "subtle": "#1b2f52"},
    "status": {"ok": "#3fb950", "warn": "#d29922", "error": "#f85149", "info": "#58a6ff"}
  },
  "space": {"xs": "4px", "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "2xl": "32px", "3xl": "48px"},
