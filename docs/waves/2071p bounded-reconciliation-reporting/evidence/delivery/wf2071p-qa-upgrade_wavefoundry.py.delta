+def _reporting_budget() -> float:
+    try:
+        requested = float(os.environ.get(_REPORTING_BUDGET_ENV, _REPORTING_WORK_SECONDS))
+        return min(_REPORTING_WORK_SECONDS, max(0.0, requested))
+    except ValueError:
+        return _REPORTING_WORK_SECONDS
+
+
+def _empty_reporting(state="incomplete", reason="not_assessed") -> dict:
+    return {"reconciliation": [], "host_permission_flags": [], "renderer_provenance_flags": [],
+            "reconciliation_state": state, "reconciliation_reason": reason[:160],
+            "reconciliation_last_path": "", "reconciliation_last_stage": "start",
+            "reconciliation_elapsed": 0.0, "reconciliation_visited_entries": 0,
+            "reconciliation_eligible_files": 0, "reconciliation_read_files": 0,
+            "reconciliation_read_bytes": 0, "reconciliation_candidates": 0,
+            "disposition_diagnostics": [], "renderer_warnings": [],
+            "agent_surface_integrity": {"available": False, "finding_count": 0}}
+
+
+def _report_fields(report):
+    return {key: value for key, value in report.items() if key.startswith("reconciliation_")}
+
+
+def _produce_reconciliation_report(root: Path) -> int:
+    """Owned, non-publishing worker. Parent enforces the hard timeout."""
+    import reconcile_scan
+    budget = _reporting_budget()
+    started = time.monotonic()
+    progress_path = os.environ.get(_REPORTING_PROGRESS_ENV)
+    def progress(value):
+        # No text/matches/contents, only bounded relative coordinates and counts.
+        if progress_path and value["last_stage"] != "candidate":
+            Path(progress_path).write_text(json.dumps(value), encoding="utf-8")
+    if not hasattr(reconcile_scan, "scan_repo_result"):
+        # Compatibility fixture/older scanner: the owned parent still enforces
+        # its deadline, and malformed tuple shapes fail rather than look clean.
+        report = _empty_reporting("complete", "")
+        channels = _run_reconciliation_scan(root)
+        for key, values in zip(("reconciliation", "host_permission_flags", "renderer_provenance_flags"), channels):
+            report[key] = values
+        report["renderer_warnings"] = _run_renderer_warning_scan(root)
+        print(json.dumps(report, ensure_ascii=False), flush=True)
+        return 0
+    result = (reconcile_scan.ScanResult(state="incomplete", reasons=["upgrade_failed"])
+              if os.environ.get("WAVEFOUNDRY_REPORTING_SKIP_SCAN") == "1" else
+              reconcile_scan.scan_repo_result(
+                  root, limits=reconcile_scan.ScanLimits(seconds=budget), progress=progress))
+    report = _empty_reporting(result.state, ",".join(result.reasons))
+    for key in ("reconciliation", "host_permission_flags", "renderer_provenance_flags"):
+        report[key] = [ref.as_dict() for ref in getattr(result, key)]
+    for key in ("last_path", "last_stage", "elapsed", "visited_entries", "eligible_files", "read_files", "read_bytes", "candidates"):
+        report["reconciliation_" + key] = getattr(result, key)
+    if time.monotonic() - started < budget:
+        report["disposition_diagnostics"] = reconcile_scan.disposition_diagnostics(root, findings=result.findings)
+    if time.monotonic() - started < budget:
+        report["renderer_warnings"] = _run_renderer_warning_scan(root)
+    if time.monotonic() - started < budget:
+        report["agent_surface_integrity"] = _run_agent_surface_integrity_scan(root)
+    print(json.dumps(report, ensure_ascii=False), flush=True)
+    return 0
+
+
+def _collect_reconciliation_report(root: Path | None, *, budget_s=None, skip_scan=False) -> dict:
+    """One owned child for all optional scans/diagnostics; no fallback rescan."""
+    if root is None:
+        return _empty_reporting()
+    started = time.monotonic()
+    budget = _reporting_budget() if budget_s is None else max(0.0, min(_REPORTING_WORK_SECONDS, budget_s))
+    report = _empty_reporting()
+    with tempfile.TemporaryDirectory(prefix="wf-report-") as td:
+        progress_path = Path(td) / "progress.json"
+        env = subprocess_util.utf8_child_env()
+        env.pop("WAVEFOUNDRY_UPGRADE_PUBLISHER_TOKEN", None)
+        env.pop("PYTHONPYCACHEPREFIX", None)
+        env["WAVEFOUNDRY_REPORTING_SKIP_SCAN"] = "1" if skip_scan else "0"
+        env[_REPORTING_PROGRESS_ENV] = str(progress_path)
+        env[_REPORTING_BUDGET_ENV] = str(max(0.0, budget - (time.monotonic() - started)))
+        try:
+            remaining = budget - (time.monotonic() - started)
+            if remaining <= 0:
+                raise subprocess.TimeoutExpired("reporting", budget)
+            child = subprocess_util.run_with_tree_kill(
+                [_preferred_python(), "-B", str(Path(__file__).resolve()),
+                 "--reconciliation-report", "--root", str(root)],
+                cwd=str(root), env=env, capture_output=True, text=True,
+                check=False, timeout=remaining)
+            if child.returncode:
+                report = _empty_reporting("error", "worker_exit_" + str(child.returncode))
+            else:
+                parsed = json.loads(child.stdout)
+                if not isinstance(parsed, dict) or parsed.get("reconciliation_state") not in ("complete", "incomplete", "error"):
+                    raise ValueError("report protocol")
+                report = parsed
+        except subprocess.TimeoutExpired:
+            report = _empty_reporting("incomplete", "reporting_timeout")
+        except Exception as exc:
+            report = _empty_reporting("error", "reporting_" + type(exc).__name__)
+        if report["reconciliation_state"] != "complete":
+            try:
+                with progress_path.open("rb") as stream:
+                    progress = json.loads(stream.read(4096))
+                for key in ("last_path", "last_stage", "elapsed", "visited_entries", "eligible_files", "read_files", "read_bytes", "candidates"):
+                    if key in progress:
+                        report["reconciliation_" + key] = progress[key]
+            except (OSError, ValueError):
+                pass
+    report["reconciliation_elapsed"] = time.monotonic() - started
+    return report
+
+
