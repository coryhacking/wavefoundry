{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy,sys; root=os.environ.get('CLAUDE_PROJECT_DIR'); root or sys.exit('wavefoundry hook .claude/hooks/pre-edit.py: missing project root environment variable CLAUDE_PROJECT_DIR'); runpy.run_path(os.path.join(root, '.claude', 'hooks', 'pre-edit.py'), run_name='__main__')\"",
            "statusMessage": "Checking framework edit gates..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy,sys; root=os.environ.get('CLAUDE_PROJECT_DIR'); root or sys.exit('wavefoundry hook .claude/hooks/post-edit.py: missing project root environment variable CLAUDE_PROJECT_DIR'); runpy.run_path(os.path.join(root, '.claude', 'hooks', 'post-edit.py'), run_name='__main__')\"",
            "statusMessage": "Running docs gates..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy,sys; root=os.environ.get('CLAUDE_PROJECT_DIR'); root or sys.exit('wavefoundry hook .claude/hooks/session-capture.py: missing project root environment variable CLAUDE_PROJECT_DIR'); runpy.run_path(os.path.join(root, '.claude', 'hooks', 'session-capture.py'), run_name='__main__')\"",
            "statusMessage": "Capturing session state..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy,sys; root=os.environ.get('CLAUDE_PROJECT_DIR'); root or sys.exit('wavefoundry hook .claude/hooks/context-efficiency-project.py: missing project root environment variable CLAUDE_PROJECT_DIR'); runpy.run_path(os.path.join(root, '.claude', 'hooks', 'context-efficiency-project.py'), run_name='__main__')\"",
            "statusMessage": "Scheduling context-efficiency projection..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "mcp__wavefoundry__code_ask",
      "mcp__wavefoundry__code_callgraph",
